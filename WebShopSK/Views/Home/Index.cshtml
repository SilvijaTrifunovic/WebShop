
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    @if (string.IsNullOrWhiteSpace(ViewBag.Message))
    {
        <h1 class="display-4">Welcome</h1>
    }
    else
    {
        <h1 class="display-4 text-success">@ViewBag.Message</h1>
        <br />
        <a class="btn btn-success btn-lg display-4" href="/">Continue shopping</a>
    }
</div>
