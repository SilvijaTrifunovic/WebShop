@model WebShopSK.ViewModels.UserOrderViewModel

@{
	ViewData["Title"] = "Cart";
	var cartItems = ViewBag.CartItems;
}

<div class="text-center">
	<h1>Place your order</h1>
</div>


@if (cartItems.Count == 0)
{
	<div class="text-center">
		<h1>Your cart is empty!</h1>
		<hr />
		<a class="btn btn-primary btn-lg float-lg-start" asp-controller="Home" asp-action="Products"> Continue shopping</a>
	</div>
}
else
{
	<div class="text-center">
		<h3>Cart items:</h3>
	</div>
	<br />

	<partial name="_CartItems" model="@cartItems" />

	<div class="text-center">
		<h3>Personal informations</h3>
	</div>
	<br />
	<div>
		<form method="post" asp-controller="Home" asp-action="CreateOrder">
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>
			<input type="hidden" name="TotalPrice" value="@ViewBag.TotalPrice.ToString("0.00")" />

			<div class="row">
				<div class="form-group col-6">
					<label asp-for="OrderAdress.BillingFirstName" class="control-label"></label>
					<input asp-for="OrderAdress.BillingFirstName" class="form-control" />
					<span asp-validation-for="OrderAdress.BillingFirstName" class="text-danger"></span>
				</div>
				<div class="form-group col-6">
					<label asp-for="OrderAdress.BillingLastName" class="control-label"></label>
					<input asp-for="OrderAdress.BillingLastName" class="form-control" />
					<span asp-validation-for="OrderAdress.BillingLastName" class="text-danger"></span>
				</div>
			</div>
			<div class="row">
				<div class="form-group col-6">
					<label asp-for="OrderAdress.BillingEmail" class="control-label"></label>
					<input asp-for="OrderAdress.BillingEmail" class="form-control" />
					<span asp-validation-for="OrderAdress.BillingEmail" class="text-danger"></span>
				</div>
				<div class="form-group col-6">
					<label asp-for="OrderAdress.BillingPhone" class="control-label"></label>
					<input asp-for="OrderAdress.BillingPhone" class="form-control" />
					<span asp-validation-for="OrderAdress.BillingPhone" class="text-danger"></span>
				</div>
			</div>
			<div class="row">
				<div class="form-group col-12">
					<label asp-for="OrderAdress.BillingAdress" class="control-label"></label>
					<input asp-for="OrderAdress.BillingAdress" class="form-control" />
					<span asp-validation-for="OrderAdress.BillingAdress" class="text-danger"></span>
				</div>
			</div>
			<div class="row">
				<div class="form-group col-6">
					<label asp-for="OrderAdress.BillingCity" class="control-label"></label>
					<input asp-for="OrderAdress.BillingCity" class="form-control" />
					<span asp-validation-for="OrderAdress.BillingCity" class="text-danger"></span>
				</div>
				@* 				<div class="form-group col-3">
			<label asp-for="OrderAdress.BillingCountry" class="control-label"></label>
			<input asp-for="OrderAdress.BillingCountry" class="form-control" />
			<span asp-validation-for="OrderAdress.BillingCountry" class="text-danger"></span>
			</div>
			*@				<div class="form-group col-3">
					<label asp-for="OrderAdress.BillingZipCode" class="control-label"></label>
					<input asp-for="OrderAdress.BillingZipCode" class="form-control" />
					<span asp-validation-for="OrderAdress.BillingZipCode" class="text-danger"></span>
				</div>
			</div>
			<div class="row">
				<div class="form-group col-12">
					<label asp-for="Message" class="control-label"></label>
					<textarea asp-for="Message" rows="3" cols="50" name="Message" class="form-control"></textarea>
					<span asp-validation-for="Message" class="text-danger"></span>
				</div>
			</div>
			<br />
			<div class="form-group d-flex justify-content-end mt-3">
				<input type="submit" value="Place order" class="btn btn-success btn-lg" />
			</div>
		</form>
	</div>
}