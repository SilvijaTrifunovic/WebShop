@using WebShopSK.Models

@model List<CartItem>

@if (Model.Count == 0)
{
	<div class="text-center">
		<h1>Your cart is empty!</h1>
		<hr />
		<a class="btn btn-primary btn-lg float-lg-start" asp-controller="Home" asp-action="Products"> Continue shopping</a>
	</div>
}
else
{
	<table class="table">
		<thead>
			<tr>
				@if (ViewBag.ShorRemoveAction)
				{
					<th></th>					
				}
				<th>Product</th>
				<th>Price</th>
				<th>Quantity</th>
				<th>Total</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					@if (ViewBag.ShorRemoveAction)
					{
						<td>
							<a class="btn btn-danger" asp-action="RemoveFromCart" asp-route-productId="@item.Product.Id">Delete</a>
						</td>
					}
					<td>
						@item.Product.Title)
					</td>
					<td>
						@item.Product.Price.ToString("0.00") €
					</td>
					<td>
						@item.Product.Quantity)
					</td>
					<td>
						@item.GetTotal().ToString("0.00") €
					</td>
				</tr>
			}
			<tr>
				<td></td>
				<td></td>
				<td></td>
				<td></td>
				<td class="fw-bold">Total price: @ViewBag.TotalPrice.ToString("0.00") €</td>
			</tr>

		</tbody>
	</table>
	<br />
}