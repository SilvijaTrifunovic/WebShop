@model WebShopSK.Models.Order

@{
    ViewData["Title"] = "Details";
}

<div class="d-flex justify-content-between align-items-center">
    <h3>Order Details</h3>
    <a asp-action="Create" asp-controller="OrderItem" asp-route-orderId="@Model?.Id" class="btn btn-primary">
        Dodaj stavku na narudžbu
    </a>
</div>

<hr />

<div>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DateCreated)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DateCreated)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Total)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Total)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BillingFirstName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.BillingFirstName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BillingLastName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.BillingLastName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BillingEmail)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.BillingEmail)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BillingPhone)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.BillingPhone)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BillingAdress)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.BillingAdress)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BillingCity)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.BillingCity)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BillingZipCode)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.BillingZipCode)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Message)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Message)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.UserId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.UserId)
        </dd>
    </dl>
</div>
<hr />
<h3>Stavke narudžbe:</h3>

<partial name="_OrderItemsPartial" for="@Model.OrderItems"></partial>
<br />
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
